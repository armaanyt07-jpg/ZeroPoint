# Copy to .env.local (git-ignored) for `pnpm dashboard`, and set the same names in
# the Vercel project (Settings -> Environment Variables). NEVER commit real values.

# Supabase project URL and anon (public) key: used only for admin sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only. Bypasses RLS: the dashboard reads and writes through it after the admin check.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Server-only. MUST be the same value as the Worker's CREDENTIAL_ENCRYPTION_KEY,
# or the Worker cannot decrypt provider keys saved here.
CREDENTIAL_ENCRYPTION_KEY=replace-me

# Optional but recommended: lets changes (revoked keys, blocked users, prices)
# apply on the next request instead of up to 60 s later. Same Upstash database as the Worker.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Recommended in production: the public URL magic links point back to.
# DASHBOARD_URL=https://zeropoint-admin.example.com
