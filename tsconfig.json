{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@zeropoint/types": ["./packages/types/src/index.ts"],
      "@zeropoint/crypto": ["./packages/crypto/src/index.ts"],
      "@zeropoint/pricing": ["./packages/pricing/src/index.ts"],
      "@zeropoint/providers": ["./packages/providers/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "tests"]
}
